<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootConfirmarDevolucion"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF"
    tools:context=".view.devolucion.ConfirmarDevolucionActivity"
    tools:ignore="HardcodedText,ContentDescription">

    <!-- ===================== HEADER ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHeader"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:cardBackgroundColor="#FBFBFF"
        app:cardCornerRadius="0dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgLogoHeader"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="27dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_utp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/llHeaderTextos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imgLogoHeader"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvHeaderTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Confirmar devolución"
                    android:textColor="#131B2E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:text="UTP • CAMPUS ATE"
                    android:textColor="#5B6070"
                    android:textSize="10sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== CONTENIDO ===================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/cardBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardHeader">

        <LinearLayout
            android:id="@+id/llContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="27dp"
            android:paddingTop="8dp"
            android:paddingEnd="27dp"
            android:paddingBottom="32dp">

            <!-- Volver al panel -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clVolver"
                android:layout_width="match_parent"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/imgVolver"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#131B2E" />

                <TextView
                    android:id="@+id/tvVolverPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="VOLVER AL PANEL"
                    android:textColor="#131B2E"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imgVolver"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvSeccionReclamacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="Confirmar devolución"
                android:textColor="#131B2E"
                android:textSize="13sp" />

            <!-- Cuerpo de la reclamación aprobada y objeto -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCuerpoReclamacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvEstadoReclamacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aprobada"
                        android:textColor="#1B7A43"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCodigoObjeto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="UTP-2026-0142"
                        android:textColor="#1C1B1F"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCategoriaObjeto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Laptop"
                        android:textColor="#5F6368"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDescripcionObjeto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Laptop negra con stickers de la UTP y funda de tela."
                        android:textColor="#1C1B1F"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Datos del receptor -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReceptor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvTituloReceptor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Datos del receptor"
                        android:textColor="#1C1B1F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLabelReceptor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:text="ID DE LA PERSONA"
                        android:textColor="#334155"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etReceptorId"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="sans-serif-medium"
                        android:hint="Identificador de la persona"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#1C1B1F"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvLabelDni"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:text="DNI"
                        android:textColor="#334155"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etDni"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="sans-serif-medium"
                        android:hint="8 dígitos"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#1C1B1F"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvErrorDni"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        android:text="El DNI debe tener 8 dígitos."
                        android:textColor="#B5122B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvLabelCorreo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:text="CORREO"
                        android:textColor="#334155"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="sans-serif-medium"
                        android:hint="correo@utp.edu.pe"
                        android:importantForAutofill="no"
                        android:inputType="textEmailAddress"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#1C1B1F"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvErrorCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        android:text="Ingresa un correo con formato válido."
                        android:textColor="#B5122B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvErrorReceptor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        android:text="Selecciona un receptor válido."
                        android:textColor="#B5122B"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Captura de firma -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFirma"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Firma"
                            android:src="@drawable/ic_signature" />

                        <TextView
                            android:id="@+id/tvTituloFirma"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Firma del receptor"
                            android:textColor="#1C1B1F"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/btnLimpiarFirma"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="monospace"
                            android:text="Limpiar Trazo"
                            android:textColor="#5F6368"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.Jair.practica.view.devolucion.FirmaCanvasView
                        android:id="@+id/viewFirma"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="10dp"
                        android:background="#FFFFFF"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/tvErrorFirma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        android:text="La firma del receptor es obligatoria."
                        android:textColor="#B5122B"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Confirmación -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConfirmar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvTituloConfirmar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Confirmar entrega física"
                        android:textColor="#1C1B1F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirmarDevolucion"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:enabled="false"
                        android:fontFamily="monospace"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="CONFIRMAR ENTREGA"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#B5122B"
                        app:cornerRadius="8dp"
                        app:elevation="4dp"
                        app:icon="@drawable/ic_check_circle_white"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="20dp"
                        app:iconTint="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvErrorGeneral"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:text="No fue posible confirmar la entrega."
                        android:textColor="#B5122B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMensajeExito"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:text="Devolución confirmada."
                        android:textColor="#1B7A43"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvErrorCarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:text="No fue posible cargar la confirmación."
                android:textColor="#B5122B"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===================== BOTTOM NAV ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/bottom_nav" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
