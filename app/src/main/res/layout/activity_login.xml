<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF">

    <!-- GUIDELINES -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="21dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="21dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideInfoTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.705" />

    <!-- BADGE ACCESO INSTITUCIONAL -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBadgeAcceso"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#FFF0F2"
        app:cardCornerRadius="13dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#FBCDD3"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPuntoBadge"
                android:layout_width="8dp"
                android:layout_height="8dp"
                app:cardBackgroundColor="#B80C2E"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <TextView
                android:id="@+id/tvBadgeAcceso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="ACCESO INSTITUCIONAL"
                android:textColor="#B80C2E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- TITULO -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:includeFontPadding="false"
        android:text="Iniciar Sesión"
        android:textColor="#0F172A"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toBottomOf="@id/cardBadgeAcceso" />

    <!-- SUBTITULO -->
    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:text="Ingresa tus credenciales institucionales autorizadas para continuar."
        android:textColor="#64748B"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo" />

    <TextView
        android:id="@+id/tvLabelRolLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:text="ROL DE ACCESO"
        android:textColor="#334155"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitulo" />

    <RadioGroup
        android:id="@+id/rgRolLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toBottomOf="@id/tvLabelRolLogin">

        <RadioButton
            android:id="@+id/rbPersonalRegistrador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Personal registrador"
            android:textColor="#475569"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rbAdministradorSae"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Administrador SAE"
            android:textColor="#475569"
            android:textSize="12sp" />
    </RadioGroup>

    <!-- LABEL USUARIO -->
    <TextView
        android:id="@+id/tvLabelUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:text="USUARIO O CÓDIGO INSTITUCIONAL"
        android:textColor="#334155"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toBottomOf="@id/rgRolLogin" />

    <!-- INPUT USUARIO -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardUsuario"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="11dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toBottomOf="@id/tvLabelUsuario"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/imgIconoUsuario"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_usuario"
                app:tint="#94A3B8" />

            <EditText
                android:id="@+id/etUsuario"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:autofillHints="username"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:inputType="text"
                android:hint="Escribe tu usuario"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- LABEL CONTRASEÑA -->
    <TextView
        android:id="@+id/tvLabelContrasena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:text="CONTRASEÑA"
        android:textColor="#334155"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toBottomOf="@id/cardUsuario" />

    <!-- LINK OLVIDASTE TU CLAVE -->
    <TextView
        android:id="@+id/tvOlvidasteClave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:text="¿Olvidaste tu clave?"
        android:textColor="#B80C2E"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="@id/tvLabelContrasena" />

    <!-- INPUT CONTRASEÑA -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContrasena"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="11dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toBottomOf="@id/tvLabelContrasena"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/imgIconoCandado"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_candado"
                app:tint="#94A3B8" />

            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:autofillHints="password"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:hint="Escribe tu contraseña"
                android:inputType="textPassword"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgMostrarClave"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:contentDescription="Mostrar u ocultar contraseña"
                android:focusable="true"
                android:src="@drawable/ic_ojo"
                app:tint="#94A3B8" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- CHECKBOX MANTENER SESION -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCheckMantener"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#B80C2E"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toBottomOf="@id/cardContrasena"
        app:strokeWidth="0dp" />

    <TextView
        android:id="@+id/tvMantenerSesion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:includeFontPadding="false"
        android:text="Mantener sesión iniciada en este dispositivo"
        android:textColor="#475569"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/cardCheckMantener"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toEndOf="@id/cardCheckMantener"
        app:layout_constraintTop_toTopOf="@id/cardCheckMantener" />

    <!-- BOTON INGRESAR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnLogin"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:clickable="true"
        android:focusable="true"
        android:outlineAmbientShadowColor="#66B80C2E"
        android:outlineSpotShadowColor="#B80C2E"
        app:cardBackgroundColor="#B80C2E"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toBottomOf="@id/cardCheckMantener"
        app:strokeWidth="0dp"
        tools:targetApi="p">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBtnLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.01"
                android:text="Ingresar al Sistema"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgFlechaLogin"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="9dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_flecha_derecha"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- CARD INFO CREDENCIALES -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInfoCredenciales"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toTopOf="@id/guideInfoTop"
        app:strokeColor="#FBD5DA"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIconoInfo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="2dp"
                app:cardBackgroundColor="#FDEEF0"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imgIconoInfo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_reloj"
                    app:tint="#B80C2E" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInfoTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="¿No recuerdas tus credenciales UTP?"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInfoDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3.5dp"
                    android:text="Si no recuerdas tu código o contraseña, comunícate con el SAE UTP o visita los módulos de atención en campus."
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============ NOTA DE CREDENCIALES (demo) ============ -->
    <!-- Personal registrador -> usuario: jair   contraseña: jair
         Administrador SAE   -> usuario: jair   contraseña: jair123 -->
    <TextView
        android:id="@+id/tvNotaCredenciales"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:text="CREDENCIALES DEMO\nPersonal registrador: jair / jair\nAdministrador SAE:   jair / jair123"
        android:textColor="#64748B"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toBottomOf="@id/cardInfoCredenciales" />

    <!-- FOOTER -->
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.05"
        android:text="SISTEMA INTERNO • VERSIÓN WIREFRAME 1.0"
        android:textColor="#B5BFD1"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toBottomOf="@id/tvNotaCredenciales" />

</androidx.constraintlayout.widget.ConstraintLayout>
