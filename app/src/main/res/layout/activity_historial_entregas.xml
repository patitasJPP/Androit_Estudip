<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootSolicitudesResueltas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FD"
    android:fitsSystemWindows="true"
    tools:context=".view.devolucion.HistorialEntregasActivity"
    tools:ignore="HardcodedText,ContentDescription,SmallSp,UnusedAttribute,RtlHardcoded">

    <!-- ===================== TOP BAR ===================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:background="#F7F8FD"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogoTopBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imgLogoTopBar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_utp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/llTitulosTopBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardLogoTopBar"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvTituloTopBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Objetos Perdidos"
                android:textColor="#1B1B25"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtituloTopBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="UTP • CAMPUS ATE"
                android:textColor="#6B6F7B"
                android:textSize="10sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===================== CONTENIDO ===================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:id="@+id/llContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- ============ HEADER CARD ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#F0F0F5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/imgLogoMini"
                            android:layout_width="24dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="3dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/logo_utp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badgeModuloServicio"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:layout_marginStart="10dp"
                            app:cardBackgroundColor="#FCE4EA"
                            app:cardCornerRadius="4dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/imgLogoMini"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeWidth="0dp">

                            <TextView
                                android:id="@+id/tvModuloServicio"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:letterSpacing="0.06"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="MÓDULO DE SERVICIO"
                                android:textColor="#A3002F"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badgeAuditoria"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            app:cardBackgroundColor="#EEF0F5"
                            app:cardCornerRadius="11dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="10dp"
                                android:paddingEnd="12dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/dotAuditoria"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    app:cardBackgroundColor="#12B76A"
                                    app:cardCornerRadius="4dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp" />

                                <TextView
                                    android:id="@+id/tvAuditoria"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="2dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="Auditoría 2026"
                                    android:textColor="#1B1B25"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/tvTituloHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Solicitudes Resueltas"
                        android:textColor="#1B1B25"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubtituloHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Historial de bienes devueltos y actas oficiales de entrega en custodia institucional."
                        android:textColor="#5B5F6B"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ BUSCADOR ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBuscador"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="36dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/imgBuscar"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        android:tint="#44474F" />

                    <EditText
                        android:id="@+id/etBuscar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="código de estudiante, DNI..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="#1B1B25"
                        android:textColorHint="#6B6F7B"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/imgFiltros"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_tune"
                        android:tint="#44474F" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ CHIPS DE FILTRO ============ -->
            <HorizontalScrollView
                android:id="@+id/scrollChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/grupoFiltrosHistorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedChip="@id/chipTodas"
                    app:chipSpacingHorizontal="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTodas"
                        style="@style/Widget.Practica.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/filtro_todas"
                        app:chipIcon="@drawable/ic_check_circle" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEstaSemana"
                        style="@style/Widget.Practica.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/filtro_semana"
                        app:chipIcon="@drawable/ic_calendar" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLaptops"
                        style="@style/Widget.Practica.ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/filtro_laptops"
                        app:chipIcon="@drawable/ic_laptop" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- ============ ERROR DE CARGA / ACCESO ============ -->
            <TextView
                android:id="@+id/tvErrorCarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:text="No fue posible cargar el historial de entregas."
                android:textColor="#B5122B"
                android:textSize="12sp" />

            <!-- ============ FILTROS ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFiltros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <EditText
                        android:id="@+id/etFiltroFechaInicio"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:hint="Fecha inicio (yyyy-MM-dd)"
                        android:imeOptions="actionDone"
                        android:inputType="date"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#1B1B25"
                        android:textColorHint="#6B6F7B"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etFiltroFechaFin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:hint="Fecha fin (yyyy-MM-dd)"
                        android:imeOptions="actionDone"
                        android:inputType="date"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#1B1B25"
                        android:textColorHint="#6B6F7B"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etFiltroReceptor"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:hint="ID o nombre del receptor"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#1B1B25"
                        android:textColorHint="#6B6F7B"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvErrorFiltroFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        android:text="La fecha de inicio debe ser menor o igual a la fecha de fin."
                        android:textColor="#B5122B"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ LISTA DE ENTREGAS CONFIRMADAS ============ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistorialEntregas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvHistorialVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:text="No se encontraron entregas confirmadas."
                android:textColor="#5B5F6B"
                android:textSize="13sp"
                android:visibility="gone" />
            <!-- ============ AUDITORÍA Y TRAZABILIDAD ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAuditoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#EBEBEF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardIconoAuditoria"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:cardBackgroundColor="#FADDE4"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/imgIconoAuditoria"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_security_audit"
                            android:tint="#930029" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:id="@+id/llTextoAuditoria"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTituloAuditoria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Auditoría y Trazabilidad Institucional"
                            android:textColor="#1B1B25"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCuerpoAuditoria1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="4dp"
                            android:text="Todas las actas emitidas están respaldadas con firma electrónica y custodia pericial según"
                            android:textColor="#50535E"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/llDirectiva"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvDirectivaPrefijo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="4dp"
                                android:text="directiva oficial "
                                android:textColor="#50535E"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvDirectivaCodigo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="4dp"
                                android:text="D-CUST-UTP-2026"
                                android:textColor="#930029"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvDirectivaSufijo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="4dp"
                                android:text=" de la"
                                android:textColor="#50535E"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCuerpoAuditoria2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="4dp"
                            android:text="Dirección de Servicios Universitarios."
                            android:textColor="#50535E"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===================== BOTTOM NAV ===================== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/bottom_nav" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
