<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootVerificarReclamacion"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF"
    tools:context=".view.devolucion.VerificarReclamacionActivity"
    tools:ignore="HardcodedText,ContentDescription">

    <!-- ===================== HEADER ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHeader"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:cardBackgroundColor="#FBFBFF"
        app:cardCornerRadius="0dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgLogoHeader"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="27dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_utp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/llHeaderTextos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imgLogoHeader"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvHeaderTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Verificar reclamación"
                    android:textColor="#131B2E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:text="UTP • CAMPUS ATE"
                    android:textColor="#5B6070"
                    android:textSize="10sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== CONTENIDO ===================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/cardBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardHeader">

        <LinearLayout
            android:id="@+id/llContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="27dp"
            android:paddingTop="8dp"
            android:paddingEnd="27dp"
            android:paddingBottom="32dp">

            <!-- Volver al panel -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clVolver"
                android:layout_width="match_parent"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/imgVolver"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#131B2E" />

                <TextView
                    android:id="@+id/tvVolverPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="VOLVER AL PANEL"
                    android:textColor="#131B2E"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imgVolver"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvSeccionReclamacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="Reclamación verificada"
                android:textColor="#131B2E"
                android:textSize="13sp" />

            <!-- Cuerpo de la reclamación -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCuerpoReclamacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvEstadoActual"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pendiente de verificación"
                            android:textColor="#5B6070"
                            android:textSize="11sp" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardBadgeEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            app:cardBackgroundColor="#FDF2F4"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#F8CED7"
                            app:strokeWidth="1dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="PENDIENTE"
                                android:textColor="#B5122B"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNombreSolicitante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="María Fernanda Quispe Rojas"
                        android:textColor="#1C1B1F"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVinculoSolicitante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Estudiante"
                        android:textColor="#5F6368"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvIdentificadorSolicitante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="U202114587"
                        android:textColor="#5F6368"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvFechaReclamacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.05"
                        android:text="2026-10-27"
                        android:textColor="#5F6368"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Comparación solicitante vs registro -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardComparacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvTituloComparacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Comparación: solicitante vs. registro"
                        android:textColor="#1C1B1F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/llComparacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvEtiquetaComparacionReclamante"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="SOLICITANTE"
                                android:textColor="#5B6070"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvValorComparacionReclamante"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Laptop negra con stickers de la UTP y funda de tela."
                                android:textColor="#1C1B1F"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvEtiquetaComparacionRegistrado"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="REGISTRO DEL OBJETO"
                                android:textColor="#5B6070"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvValorComparacionRegistrado"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Laptop negra con stickers de la UTP y funda de tela."
                                android:textColor="#1C1B1F"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llComparacionCaracteristicas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvEtiquetaCaracteristicasReclamante"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="CARACTERÍSTICAS DECLARADAS"
                                android:textColor="#5B6070"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvValorCaracteristicasReclamante"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Tiene funda gris y el cargador original; olvidé la contraseña de encendido."
                                android:textColor="#1C1B1F"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvEtiquetaCaracteristicasRegistrado"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="CARACTERÍSTICAS RESERVADAS"
                                android:textColor="#5B6070"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvValorCaracteristicasReservado"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Funda gris, cargador original, marca Lenovo, contraseña de encendido de 4 dígitos."
                                android:textColor="#1C1B1F"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Características reservadas -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCaracteristicasReservadas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FDF2F4"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="#F8CED7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvTituloCaracteristicasReservadas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Características reservadas"
                        android:textColor="#1C1B1F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvValorCaracteristicasReservadas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Funda gris, cargador original, marca Lenovo, contraseña de encendido de 4 dígitos."
                        android:textColor="#1C1B1F"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvHintCaracteristicasReservadas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Información exclusiva para el Administrador SAE."
                        android:textColor="#5B6070"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Evidencias -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEvidencias"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvTituloEvidencias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Evidencias de la reclamación"
                        android:textColor="#1C1B1F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEvidenciasTexto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Evidencia fotográfica registrada por el personal registrador."
                        android:textColor="#5F6368"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Preguntas -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPreguntas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvTituloPreguntas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Preguntas sobre características no publicadas"
                        android:textColor="#1C1B1F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvErrorPregunta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        android:text="La pregunta debe tener entre 10 y 200 caracteres."
                        android:textColor="#B5122B"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/llPreguntas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etNuevaPregunta"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="sans-serif-medium"
                            android:hint="Escribe una pregunta sobre el objeto"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#1C1B1F"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAgregarPregunta"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:fontFamily="monospace"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Agregar"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="#B5122B"
                            app:cornerRadius="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Decisión -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDecision"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvTituloDecision"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Registrar decisión de verificación"
                        android:textColor="#1C1B1F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgDecisionReclamacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbDecisionAprobar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:padding="10dp"
                            android:background="#E6EEFB"
                            android:text="Aprobada"
                            android:textColor="#B5122B"
                            android:textSize="14sp"
                            app:buttonTint="#B5122B" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbDecisionPendiente"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:minHeight="64dp"
                            android:padding="10dp"
                            android:background="#E6EEFB"
                            android:text="Pendiente de verificación"
                            android:textColor="#5B6070"
                            android:textSize="14sp"
                            app:buttonTint="#B5122B" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbDecisionRechazar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:minHeight="64dp"
                            android:padding="10dp"
                            android:background="#E6EEFB"
                            android:text="Rechazada"
                            android:textColor="#5B6070"
                            android:textSize="14sp"
                            app:buttonTint="#B5122B" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/tvErrorDecision"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        android:text="Selecciona la decisión de verificación."
                        android:textColor="#B5122B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvLabelMotivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:text="MOTIVO DE LA DECISIÓN"
                        android:textColor="#334155"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etMotivo"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="sans-serif-medium"
                        android:hint="Describe el motivo de la decisión"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#1C1B1F"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvErrorMotivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        android:text="El motivo debe tener entre 10 y 300 caracteres."
                        android:textColor="#B5122B"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegistrarDecision"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:enabled="false"
                        android:fontFamily="monospace"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Registrar decisión"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="#B5122B"
                        app:cornerRadius="6dp" />

                    <TextView
                        android:id="@+id/tvMensajeExito"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:text="Decisión registrada correctamente."
                        android:textColor="#1B7A43"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvErrorGeneral"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:text="No fue posible registrar la decisión."
                        android:textColor="#B5122B"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvErrorCarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:text="No fue posible cargar la reclamación."
                android:textColor="#B5122B"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===================== PROGRESS ===================== -->
    <ProgressBar
        android:id="@+id/progressVerificar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:indeterminateTint="#930029"
        android:visibility="visible" />

    <!-- ===================== BOTTOM NAV ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/bottom_nav" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
