<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Objetos -->
    <LinearLayout
        android:id="@+id/navObjetos"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgNavObjetos"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_nav_objetos"
            app:tint="#1B1B25" />

        <TextView
            android:id="@+id/tvNavObjetos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Objetos"
            android:textColor="#1B1B25"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Resuelto -->
    <LinearLayout
        android:id="@+id/navCustodia"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgNavCustodia"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_circle"
            app:tint="#1B1B25" />

        <TextView
            android:id="@+id/tvNavCustodia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Resuelto"
            android:textColor="#1B1B25"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Reportes -->
    <LinearLayout
        android:id="@+id/navReportes"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgNavReportes"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_nav_reportes"
            app:tint="#1B1B25" />

        <TextView
            android:id="@+id/tvNavReportes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Reportes"
            android:textColor="#1B1B25"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mi Perfil -->
    <LinearLayout
        android:id="@+id/navPerfil"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgNavPerfil"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_nav_perfil"
            app:tint="#1B1B25" />

        <TextView
            android:id="@+id/tvNavPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Mi Perfil"
            android:textColor="#1B1B25"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>