<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Practica">
        <activity
            android:name=".view.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".view.custodia.InventarioActivity"
            android:exported="false" />

        <activity
            android:name=".view.custodia.ProtocoloEntregaActivity"
            android:exported="false" />

        <activity
            android:name=".view.devolucion.HistorialEntregasActivity"
            android:exported="false" />

        <activity
            android:name=".view.devolucion.VerificacionEntregaActivity"
            android:exported="false" />

        <activity
            android:name=".view.devolucion.ActaEntregaActivity"
            android:exported="false" />

        <activity
            android:name=".view.hallazgo.RegistroHallazgoActivity"
            android:exported="false" />

        <activity
            android:name=".view.hallazgo.ConfirmarRecepcionActivity"
            android:exported="false" />

        <activity
            android:name=".view.login.SeleccionRolActivity"
            android:exported="false" />

        <!-- Integrante 3: RF-05 (registrar/reanudar pérdida) y RF-06 (buscar coincidencias) -->
        <activity
            android:name=".view.perdida.RegistrarPerdidaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".view.perdida.BuscarCoincidenciasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
